# --- required ------------------------------------------------------------
ASSEMBLYAI_API_KEY=            # streaming + batch STT. Server-side only.
GROQ_API_KEY=                  # LLM: live coach + post-call reviewer (free tier)

# --- LLM -------------------------------------------------------------------
LLM_LIVE_MODEL=openai/gpt-oss-20b     # fast, tool/JSON-capable, used during the call
LLM_REVIEW_MODEL=openai/gpt-oss-120b  # stronger, used once per call for scoring

# --- STT tuning --------------------------------------------------------------
STT_LANGUAGE_CODE=en            # always pin; auto-detect hallucinated phrases on unclear audio (docs/PROTOCOL.md)
STT_MAX_SPEAKERS=2

# --- server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=7860

# --- calls ----------------------------------------------------------------
CALLS_DIR=                     # default repo-root/calls
CALLS_DB_PATH=                 # default server/evaluator.db
